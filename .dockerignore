# Build context hygiene: everything here either bloats the image, leaks
# secrets, or gets regenerated inside the build anyway.

node_modules
.next
out
build

# Secrets must come from Coolify's environment panel, never the image.
.env
.env.*
!.env.example

.git
.gitignore
.github

# Local scratch and tooling
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode
.idea
coverage
*.tsbuildinfo
next-env.d.ts

# Regenerated by `prisma generate` during the build.
src/generated

# One-shot import scripts and their downloaded Shopify payloads; not
# needed to run the site.
scripts
shopify-raw
shopify-theme

Dockerfile
.dockerignore
README.md
