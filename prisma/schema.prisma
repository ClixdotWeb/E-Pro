// Epro Gadgets - custom e-commerce schema
// Money is ALWAYS stored as integer paise. Never use Float/Decimal for money.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------- Auth ----------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  phone         String?
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
  carts     Cart[]
  reviews   Review[]

  @@index([role])
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String  @default("IN")
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------- Catalog ----------------
// Product = a design (e.g. "Carbon Fibre Black")
// Variant = design x device model (e.g. that design for "iPhone 15 Pro")

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?       @db.Text
  status      ProductStatus @default(DRAFT)
  finish      String?
  tags        String[]
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  collections CollectionProduct[]
  variants    Variant[]
  images      ProductImage[]
  reviews     Review[]

  @@index([status])
  @@index([createdAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String? @db.Text
  imageUrl    String?
  position    Int     @default(0)

  products CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model DeviceCategory {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  position Int    @default(0)

  models DeviceModel[]
}

model DeviceModel {
  id         String  @id @default(cuid())
  slug       String  @unique
  brand      String
  name       String
  categoryId String
  active     Boolean @default(true)

  category DeviceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants Variant[]

  @@index([categoryId, brand])
}

model Variant {
  id            String @id @default(cuid())
  productId     String
  deviceModelId String
  sku           String @unique

  priceInPaise     Int
  compareAtInPaise Int?
  stock            Int     @default(0)
  trackInventory   Boolean @default(true)
  weightGrams      Int     @default(30)
  active           Boolean @default(true)

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  deviceModel DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Restrict)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([productId, deviceModelId])
  @@index([deviceModelId])
}

// ---------------- Cart ----------------

model Cart {
  id        String     @id @default(cuid())
  token     String     @unique
  userId    String?
  status    CartStatus @default(OPEN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
}

enum CartStatus {
  OPEN
  CONVERTED
  ABANDONED
}

model CartItem {
  id         String @id @default(cuid())
  cartId     String
  variantId  String
  quantity   Int    @default(1)
  customData Json?

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Deliberately NOT unique on [cartId, variantId]. The same skin in
  // two different designs is two lines, and customData is what tells
  // them apart - a unique key on the variant alone would have made
  // the second design silently replace the first.
  @@index([cartId])
  @@index([variantId])
}

// ---------------- Orders ----------------

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId String?
  email  String
  phone  String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  subtotalInPaise Int
  discountInPaise Int    @default(0)
  shippingInPaise Int    @default(0)
  taxInPaise      Int    @default(0)
  totalInPaise    Int
  currency        String @default("INR")

  discountCode String?

  shippingAddress Json
  billingAddress  Json?

  trackingNumber String?
  courier        String?
  notes          String? @db.Text

  placedAt    DateTime  @default(now())
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  events   OrderEvent[]

  @@index([userId])
  @@index([status, placedAt])
  @@index([email])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

// Snapshot of what was bought - prices/titles frozen at purchase time
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String?

  productTitle String
  deviceName   String
  sku          String
  unitInPaise  Int
  quantity     Int
  totalInPaise Int
  imageUrl     String?
  customData   Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  actor     String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ---------------- Payments (Razorpay) ----------------

model Payment {
  id      String @id @default(cuid())
  orderId String

  provider          String  @default("razorpay")
  razorpayOrderId   String  @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  amountInPaise   Int
  refundedInPaise Int           @default(0)
  currency        String        @default("INR")
  method          String?
  status          PaymentStatus @default(UNPAID)
  errorCode       String?
  errorDesc       String?
  rawPayload      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Idempotency guard so a replayed webhook never double-processes
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("razorpay")
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

// ---------------- Marketing ----------------

model Discount {
  id              String       @id @default(cuid())
  code            String       @unique
  type            DiscountType
  value           Int
  minOrderInPaise Int          @default(0)
  maxUses         Int?
  usedCount       Int          @default(0)
  perUserLimit    Int?
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  rating     Int
  title      String?
  body       String?  @db.Text
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, approved])
}

// Sequential human-readable order numbers (EPRO-1001, ...)
model Counter {
  name  String @id
  value Int    @default(1000)
}

// ---------------- Designs ----------------
// The picture that goes on the skin, as opposed to the material it is
// printed on (Product.finish) or how much of the body it covers.
// Kept separate from Product because one design sells on every device:
// "Neon Dragon" is the same artwork on an iPhone 11 and a Canon R3.

model DesignCategory {
  slug     String @id
  name     String
  position Int    @default(0)

  designs Design[]
}

model Design {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  categorySlug String
  imageUrl     String?
  /** Device categories this artwork is cut for; empty means all. */
  deviceSlugs  String[]
  priceInPaise Int     @default(0)
  active       Boolean @default(true)
  position     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category DesignCategory @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)

  @@index([categorySlug, position])
  @@index([active])
}
