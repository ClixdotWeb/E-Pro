# ---- Database (Postgres) ----
# Coolify: add a PostgreSQL service, then copy its connection string here.
# Inside Coolify's own network use the service name as the host; from
# outside (e.g. running migrations from your laptop) use the public host
# and the port Coolify exposes.
#
#   postgresql://<user>:<password>@<host>:5432/<database>
#
# Coolify's Postgres requires SSL on external connections; append
# ?sslmode=require when connecting from outside the server.
DATABASE_URL="postgresql://user:password@localhost:5432/epro?schema=public"

# ---- Auth ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ---- Payments ----
# Which gateway to use. The gateway is NOT chosen yet, so this defaults
# to "mock": a local test gateway that needs no account and lets the
# whole cart -> order -> invoice flow run end to end. Production refuses
# to start on "mock".
#
#   mock      - no account needed, development only
#   razorpay  - adapter written, needs the three keys below
#   cashfree  - adapter not written yet
#   phonepe   - adapter not written yet
#   stripe    - adapter not written yet (no UPI in India)
PAYMENT_PROVIDER="mock"

# Optional: override the mock gateway's signing secret.
# MOCK_PAYMENT_SECRET=""

# ---- Razorpay (only needed when PAYMENT_PROVIDER="razorpay") ----
# Dashboard > Settings > API Keys. Use TEST keys until go-live.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard > Settings > Webhooks. You choose this string yourself.
RAZORPAY_WEBHOOK_SECRET=""

# ---- Public (exposed to the browser - never put secrets here) ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- WhatsApp ----
# The number enquiries go to, international form. Leave it unset and
# the shop uses the one on the live store.
NEXT_PUBLIC_WHATSAPP_NUMBER=919562470470
